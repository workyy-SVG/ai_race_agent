# 本地运行时的密钥配置示例
# 部署到 Streamlit Cloud 时，把这一段复制到 Cloud 的 Secrets 设置里即可
# 注意：本文件（secrets.toml）已被 .gitignore 忽略，不会被推到 GitHub

DEEPSEEK_API_KEY = "sk-你的新key"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
DEEPSEEK_MODEL = "deepseek-chat"

# 千问 (DashScope / 阿里云百炼) - Plan B RAG + 双模型
# 申请地址: https://bailian.console.aliyun.com  -> API-KEY
QWEN_API_KEY = "sk-你的千问key"
QWEN_MODEL = "qwen-plus"
QWEN_EMBEDDING_MODEL = "text-embedding-v3"

APP_USER = "judge"
APP_PASSWORD = "ai2026"
