# 本地运行时的密钥配置示例
# 部署到 Streamlit Cloud 时，把这一段复制到 Cloud 的 Secrets 设置里即可
# 注意：本文件（secrets.toml）已被 .gitignore 忽略，不会被推到 GitHub

DEEPSEEK_API_KEY = "sk-你的新key"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
# ⚠️ DeepSeek 已于 2026-07-24 停用 deepseek-chat / deepseek-reasoner，
#    当前可用名为 deepseek-v4-flash（快）/ deepseek-v4-pro（强）。
#    代码内置三级回退链，此处填错也不会让演示崩掉。
DEEPSEEK_MODEL = "deepseek-v4-flash"

# 千问 (DashScope / 阿里云百炼) - Plan B RAG + 双模型
# 申请地址: https://bailian.console.aliyun.com  -> API-KEY
QWEN_API_KEY = "sk-你的千问key"
QWEN_MODEL = "qwen-plus"
QWEN_EMBEDDING_MODEL = "text-embedding-v3"

# ⚠️ 安全：公开部署【务必】改掉下面三项默认值，否则任何知道默认口令的人都能进入。
#    代码在未配置时会回落到默认值，并在侧边栏显示橙色安全提醒。
APP_USER = "zzy"
APP_PASSWORD = "zzy2026"

# 登录后 24 小时内刷新页面保持登录；退出登录会清除浏览器凭证。
# 可选：设置独立的随机签名密钥，建议使用至少 32 字节随机值。
# 修改 APP_USER / APP_PASSWORD / 此密钥，都会让旧登录凭证失效。
# LOGIN_COOKIE_SECRET = "替换为随机生成的长字符串"

# 保活（防止 Streamlit Cloud 休眠）: 见 docs/保活部署指南.md

# 免登录演示链接: https://你的app地址/?key=ai2026demo
# · 支持逗号分隔多令牌，便于轮换（换口令时新旧可短期并存，随时可撤销）：
#     DEMO_KEY = "ai2026demo,newkey2027"
# · 可选到期日（YYYY-MM-DD），到期后所有演示令牌自动失效：
#     DEMO_KEY_EXPIRE = "2026-12-31"
DEMO_KEY = "ai2026demo"

# 每日 LLM 调用上限 (熔断保护, 防止 API 额度被刷爆)
# 评审期建议调大 (如 300), 避免评委测试时额度耗尽
DAILY_LLM_LIMIT = "100"

# 每日 Embedding 批次数上限 (RAG 建库/检索的向量化调用, 与 LLM 分开计费与熔断)
DAILY_EMBED_LIMIT = "600"
